    "test:backup-cleanup": "node tests/backup_cleanup_check.cjs"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-status-bar": "~3.0.9",
    "expo-sqlite": "~16.0.8",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "@react-native-picker/picker": "2.11.1",
    "react-native-safe-area-context": "5.6.0",
    "expo-file-system": "~19.0.0",
    "expo-sharing": "~14.0.0",
    "expo-document-picker": "~14.0.0",
    "expo-crypto": "~15.0.7",
    "expo-local-authentication": "~17.0.7",
    "expo-secure-store": "~15.0.7",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "base64-js": "^1.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "@types/react": "~19.1.10",
    "@types/base64-js": "^1.5.0"
  }
}
