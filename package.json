{
  "name": "mymoney-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "test:imports": "node tests/import_parser_test.cjs",
    "test:syntax": "node tests/source_syntax_check.cjs",
    "test:preflight": "node tests/release_preflight.cjs",
    "diagnose:build": "node tests/build_readiness.cjs",
    "verify:release": "node tests/release_gate.cjs",
